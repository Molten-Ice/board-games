# Flask Configuration
FLASK_APP=app_enhanced.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-random-secret-key
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# Database
DATABASE_URL=sqlite:///restaurant_recommender.db

# Server
HOST=0.0.0.0
PORT=5001

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload
MAX_UPLOAD_SIZE=16777216

# Production Settings (set in production)
# FLASK_ENV=production
# DATABASE_URL=postgresql://user:password@localhost/restaurant_db
# JWT_COOKIE_SECURE=True
